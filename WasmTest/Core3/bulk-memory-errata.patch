     (CONST at i) (CONST I32 $data(z,y).BYTES[j]) (STORE I32 `8 x $memarg0)
-    (CONST at $(i+1)) (CONST I32 $(j+1)) (CONST I32 $(n-1)) (MEMORY.INIT x y)
+    (CONST at $iadd_($size(at), i, 1)) (CONST I32 $iadd_(32, j, 1)) (CONST I32 $(n-1)) (MEMORY.INIT x y)
