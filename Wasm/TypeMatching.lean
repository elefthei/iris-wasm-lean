import Wasm.Common
import Wasm.ExternalTypes

/-! Declarative matching at closed type interfaces (Core 3.0, SpecTec 2.2). -/

namespace Wasm.CoreTypes

/-- Abstract heap subtyping, generated by the hierarchy edges rather than its lookup table. -/
inductive AbsHeap.Sub : AbsHeap → AbsHeap → Prop where
  | refl (a) : Sub a a
  | trans {a b c} : Sub a b → Sub b c → Sub a c
  | bot (a) : Sub .bot a
  | eqAny : Sub .eq .any
  | i31Eq : Sub .i31 .eq
  | structEq : Sub .struct_ .eq
  | arrayEq : Sub .array .eq
  | noneI31 : Sub .none .i31
  | noneStruct : Sub .none .struct_
  | noneArray : Sub .none .array
  | nofunc : Sub .nofunc .func
  | noexn : Sub .noexn .exn
  | noextern : Sub .noextern .extern_

private theorem abstract_trans {a b c : AbsHeap} (ab : a.matches b = true) (bc : b.matches c = true) :
    a.matches c = true := by
  cases a <;> cases b <;>
    first | exact bc | exact Bool.noConfusion ab | rfl | (cases c <;> first | rfl | exact Bool.noConfusion bc)

theorem AbsHeap.matches_iff {a b : AbsHeap} : a.matches b = true ↔ a.Sub b := by
  constructor
  · intro h
    cases a <;> cases b <;> first
      | exact Bool.noConfusion h
      | apply_rules [Sub.refl, Sub.bot, Sub.eqAny, Sub.i31Eq, Sub.structEq, Sub.arrayEq,
          Sub.noneI31, Sub.noneStruct, Sub.noneArray, Sub.nofunc, Sub.noexn, Sub.noextern]
        done
      | exact .trans .noneI31 .i31Eq
      | exact .trans (.trans .noneI31 .i31Eq) .eqAny
      | exact .trans .i31Eq .eqAny
      | exact .trans .structEq .eqAny
      | exact .trans .arrayEq .eqAny
  · intro h
    induction h with
    | refl a => cases a <;> rfl
    | trans _ _ ab bc => exact abstract_trans ab bc
    | bot a => cases a <;> rfl
    | _ => rfl

/-- Closed head matching: projections use nominal ancestry, not structural equality of bodies. -/
inductive HeapSub : Heap Defined → Heap Defined → Prop where
  | abs {a b} : a.Sub b → HeapSub (.abs a) (.abs b)
  | defined {a b} : DefinedSub a b → HeapSub (.use a) (.use b)
  | upper {d k b} : d.kind = some k → k.Sub b → HeapSub (.use d) (.abs b)
  | bot (d) : HeapSub (.abs .bot) (.use d)
  | noneStruct {d : Defined} : d.kind = some .struct_ → HeapSub (.abs .none) (.use d)
  | noneArray {d : Defined} : d.kind = some .array → HeapSub (.abs .none) (.use d)
  | nofunc {d : Defined} : d.kind = some .func → HeapSub (.abs .nofunc) (.use d)

theorem Heap.matches_iff {a b : Heap Defined} : a.matches b = true ↔ HeapSub a b := by
  constructor
  · cases a with
    | abs a =>
      cases b with
      | abs b => exact fun h ↦ .abs (AbsHeap.matches_iff.mp h)
      | use d =>
        cases hk : d.kind with
        | none => simp [Heap.matches, hk]; rintro rfl; exact .bot _
        | some k =>
          cases a <;> cases k <;> simp [Heap.matches, hk] <;> first
            | exact .bot _ | exact .noneStruct hk | exact .noneArray hk | exact .nofunc hk
    | use d =>
      cases b with
      | abs b =>
        cases hk : d.kind with
        | none => simp [Heap.matches, hk]
        | some k => exact fun h ↦ .upper hk (AbsHeap.matches_iff.mp (by simpa [Heap.matches, hk] using h))
      | use t => exact fun h ↦ .defined (Defined.matches_iff.mp h)
  · intro h
    cases h with
    | abs h => exact AbsHeap.matches_iff.mpr h
    | defined h => exact Defined.matches_iff.mpr h
    | upper hk h => simp [Heap.matches, hk, AbsHeap.matches_iff.mpr h]
    | bot => rfl
    | noneStruct hk | noneArray hk | nofunc hk => simp [Heap.matches, hk]

def Ref.Sub (a b : Ref Defined) : Prop :=
  (a.nullable = true → b.nullable = true) ∧ HeapSub a.heap b.heap

theorem Ref.matches_iff {a b : Ref Defined} : a.matches b = true ↔ a.Sub b := by
  obtain ⟨m, a⟩ := a; obtain ⟨n, b⟩ := b
  cases m <;> cases n <;> simp [Ref.matches, Ref.Sub, Heap.matches_iff]

def Val.Sub : Val Defined → Val Defined → Prop
  | .bot, _ => True
  | .ref a, .ref b => a.Sub b
  | a, b => a = b

theorem Val.matches_iff {a b : Val Defined} : a.matches b = true ↔ a.Sub b := by
  cases a <;> cases b <;> simp [Val.matches, Val.Sub, Ref.matches_iff]

theorem resultMatches_iff : ∀ (a b : List (Val Defined)),
    resultMatches a b = true ↔ Wasm.List.Forall₂ Val.Sub a b
  | [], [] => ⟨fun _ => .nil, fun _ => rfl⟩
  | [], _ :: _ | _ :: _, [] => ⟨by simp [resultMatches], fun h => by cases h⟩
  | x :: xs, y :: ys => by
    rw [resultMatches, Bool.and_eq_true, Val.matches_iff, resultMatches_iff xs ys]
    exact ⟨fun ⟨h, hs⟩ => .cons h hs, fun h => by cases h; exact ⟨‹_›, ‹_›⟩⟩

def Storage.Sub : Storage Defined → Storage Defined → Prop
  | .val a, .val b => a.Sub b
  | a, b => a = b

theorem Storage.matches_iff {a b : Storage Defined} : a.matches b = true ↔ a.Sub b := by
  cases a <;> cases b <;> simp [Storage.matches, Storage.Sub, Val.matches_iff]

def Field.Sub (a b : Field Defined) : Prop :=
  a.isMutable = b.isMutable ∧ a.storage.Sub b.storage ∧ (b.isMutable = true → b.storage.Sub a.storage)

theorem Field.matches_iff {a b : Field Defined} : a.matches b = true ↔ a.Sub b := by
  obtain ⟨m, a⟩ := a; obtain ⟨n, b⟩ := b
  cases m <;> cases n <;> simp [Field.matches, Field.Sub, Storage.matches_iff]

def Composite.Sub : Composite Defined → Composite Defined → Prop
  | .struct_ a, .struct_ b => Wasm.List.Forall₂ Field.Sub (a.take b.length) b
  | .array a, .array b => a.Sub b
  | .func ap ar, .func bp br => Wasm.List.Forall₂ Val.Sub bp ap ∧ Wasm.List.Forall₂ Val.Sub ar br
  | _, _ => False

private theorem struct_matches_iff (a b : List (Field Defined)) :
    (Composite.struct_ a).matches (.struct_ b) = true ↔ Wasm.List.Forall₂ Field.Sub (a.take b.length) b := by
  induction b generalizing a with
  | nil => cases a <;> exact ⟨fun _ => .nil, fun _ => rfl⟩
  | cons y ys ih =>
    cases a with
    | nil => exact ⟨fun h => Bool.noConfusion h, fun h => by cases h⟩
    | cons x xs =>
      change (x.matches y && (Composite.struct_ xs).matches (.struct_ ys)) = true ↔
        Wasm.List.Forall₂ Field.Sub (x :: xs.take ys.length) (y :: ys)
      rw [Bool.and_eq_true, Field.matches_iff, ih]
      exact ⟨fun ⟨h, hs⟩ => .cons h hs, fun h => by cases h; exact ⟨‹_›, ‹_›⟩⟩

theorem Composite.matches_iff {a b : Composite Defined} : a.matches b = true ↔ a.Sub b := by
  cases a <;> cases b <;> first | exact struct_matches_iff .. |
    simp [Composite.matches, Composite.Sub, Field.matches_iff, resultMatches_iff]

def External.Sub : External Defined → External Defined → Prop
  | .func a, .func b => DefinedSub a b
  | .tag a, .tag b => DefinedSub a b ∧ DefinedSub b a
  | .global_ m a, .global_ n b => m = n ∧ a.Sub b ∧ (n = true → b.Sub a)
  | .mem a, .mem b => a.address = b.address ∧ a.limits.Sub b.limits
  | .table a l e, .table b k f => a = b ∧ l.Sub k ∧ e.Sub f ∧ f.Sub e
  | _, _ => False

theorem External.matches_iff {a b : External Defined} : a.matches b = true ↔ a.Sub b := by
  cases a <;> cases b <;> simp [External.matches, External.Sub, Defined.matches_iff,
    Limits.matches_iff, Ref.matches_iff, Val.matches_iff, and_assoc]
  grind

/-- A closed group member may extend one earlier, non-final parent with a compatible body. -/
def Sub.ValidParent (s : Sub (Scope Defined)) (g : RecGroup (Scope Defined)) (i : Nat) : Prop :=
  match s.supers with
  | [] => True
  | [p] =>
    (∀ j, p = .bound j → j < i) ∧ ∃ d parent body,
      p.openIn g = some d ∧ d.unroll = some parent ∧ parent.isFinal = false ∧
      s.body.substM (Scope.openIn g) = some body ∧ body.Sub parent.body
  | _ => False

theorem Sub.validParent_iff {s : Sub (Scope Defined)} {g i} : s.validParent g i = true ↔ s.ValidParent g i := by
  obtain ⟨final, supers, c⟩ := s
  rcases supers with _ | ⟨p, _ | ⟨q, ps⟩⟩
  · simp [validParent, ValidParent]
  · cases p with
    | bound j =>
      by_cases hj : j < i
      · simp [validParent, ValidParent, hj, Nat.not_le_of_gt hj]
        repeat' split <;> simp_all [Composite.matches_iff]
      · simp [validParent, ValidParent, hj, Nat.le_of_not_gt hj]
    | free d =>
      simp [validParent, ValidParent, Scope.openIn]
      repeat' split <;> simp_all [Composite.matches_iff]
  · simp [validParent, ValidParent]

/-- Type indices after the group are exactly the projections in declaration order. -/
def ValidGroup (prior : Array Defined) (raw : RecGroup Nat) (out : Array Defined) : Prop :=
  ∃ g, closeGroup prior raw = some g ∧ (∀ entry ∈ g.zipIdx, entry.1.ValidParent g entry.2) ∧
    out.toList = prior.toList ++ (List.range' 0 g.length).map (Defined.proj g)

private theorem validateMembers_iff (g : RecGroup (Scope Defined)) (rest : RecGroup (Scope Defined))
    (i : Nat) (acc out : Array Defined) :
    validateGroup.go g i rest acc = some out ↔
    (∀ entry ∈ rest.zipIdx i, entry.1.ValidParent g entry.2) ∧
      out.toList = acc.toList ++ (List.range' i rest.length).map (Defined.proj g) := by
  induction rest generalizing i acc with
  | nil => simp [validateGroup.go, eq_comm]
  | cons s ss ih =>
    simp [validateGroup.go, List.zipIdx_cons, List.range'_succ, ih, Sub.validParent_iff,
      List.append_assoc, and_assoc]

theorem validateGroup_iff {prior raw out} : validateGroup prior raw = some out ↔ ValidGroup prior raw out := by
  cases hc : closeGroup prior raw <;> simp [validateGroup, ValidGroup, hc, validateMembers_iff]

inductive ValidGroups : Array Defined → List (RecGroup Nat) → Array Defined → Prop where
  | nil (types) : ValidGroups types [] types
  | cons {types raw next rest out} : ValidGroup types raw next → ValidGroups next rest out →
      ValidGroups types (raw :: rest) out

private theorem validateFold_iff {types groups out} :
    groups.foldlM validateGroup types = some out ↔ ValidGroups types groups out := by
  induction groups generalizing types with
  | nil => exact ⟨fun h => by cases h; constructor, fun h => by cases h; rfl⟩
  | cons g gs ih =>
    constructor
    · intro h
      cases hg : validateGroup types g with
      | none => simp [List.foldlM_cons, hg] at h
      | some next => exact .cons (validateGroup_iff.mp hg) (ih.mp (by simpa [List.foldlM_cons, hg] using h))
    · intro h
      cases h with
      | cons hg hs => simp [List.foldlM_cons, validateGroup_iff.mpr hg, ih.mpr hs]

theorem validateGroups_iff {groups out} : validateGroups groups = some out ↔ ValidGroups #[] groups out :=
  validateFold_iff

end Wasm.CoreTypes
